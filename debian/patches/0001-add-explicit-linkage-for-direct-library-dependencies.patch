 target_link_libraries(${GST_QTI_ML_AUDIO_CLASSIFICATION} PRIVATE
@@ -68,6 +76,7 @@ target_link_libraries(${GST_QTI_ML_AUDIO_CLASSIFICATION} PRIVATE
   ${GST_QCOM_VIDEO_LIBRARIES}
   ${GST_QCOM_MEM_LIBRARIES}
   ${GST_QCOM_UTILS_LIBRARIES}
+  ${GST_QCOM_ALLOC_LIBRARIES}
