 gst-plugin-videotemplate/CMakeLists.txt             |  9 +++++++++
 gst-plugin-voverlay/CMakeLists.txt                  |  1 +
 9 files changed, 37 insertions(+)

diff --git a/gstreamer/gst-plugin-metatransform/modules/CMakeLists.txt b/gstreamer/gst-plugin-metatransform/modules/CMakeLists.txt
